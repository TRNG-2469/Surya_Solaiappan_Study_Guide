<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

        <bean id="EngineBean" class="Engine">
                <constructor-arg value="Petrol"/>
                <constructor-arg value="120"/>
        </bean>

        <bean id="CarBean" class="Car">
                <constructor-arg value="Toyota Prius"/>
                <constructor-arg value="10100"/>
                <constructor-arg ref="EngineBean"/>
        </bean>

</beans>